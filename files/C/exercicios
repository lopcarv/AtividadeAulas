/*
====================================================
EXERCÍCIO 15
Cronômetro utilizando millis()
====================================================
*/

void setup() {

  Serial.begin(9600);

}

void loop() {

  unsigned long segundos;

  segundos = millis() / 1000;

  Serial.print("Tempo: ");
  Serial.print(segundos);
  Serial.println(" segundos");

  delay(1000);

}

/*
====================================================
DESAFIO COMPLEMENTAR
Painel de Telemetria
====================================================
*/

String aluno = "Luis";

int contador = 0;

float temperatura = 26.5;

void setup() {

  Serial.begin(9600);

}

void loop() {

  contador++;

  float nota1 = 8.0;
  float nota2 = 7.5;
  float nota3 = 9.0;

  float media = (nota1 + nota2 + nota3) / 3;

  Serial.println("================================");

  Serial.print("Aluno: ");
  Serial.println(aluno);

  Serial.print("Tempo ligado: ");
  Serial.print(millis()/1000);
  Serial.println(" s");

  Serial.print("Temperatura: ");
  Serial.print(temperatura);
  Serial.println(" C");

  Serial.print("Media: ");
  Serial.println(media);

  Serial.print("Contador: ");
  Serial.println(contador);

  Serial.println("================================");

  delay(1000);

}